#!/bin/sh
# phorward-check <phpcs|phpcbf|phpstan|phpunit> [paths...]: run one tool the way the project would. Prefers the
# project's own vendor/bin and its own configuration; falls back to the image's tools and to sensible
# defaults (PSR-12, level 5, the tests directory) when the project has none. Run inside the project root.
set -eu
tool="$1"; shift
bin="$tool"
[ -x "vendor/bin/$tool" ] && bin="vendor/bin/$tool"
src=""
for d in src lib app; do [ -d "$d" ] && src="$src $d"; done
has() { for f in "$@"; do [ -f "$f" ] && return 0; done; return 1; }
case "$tool" in
  phpcs|phpcbf)
    if [ "$tool" = phpcbf ]; then
      # Fix in place in the writable copy (with-project made it), then print what changed against the read-only
      # tree as a unified diff on standard output; the tool's own output goes to standard error.
      rc=0
      if has phpcs.xml phpcs.xml.dist .phpcs.xml .phpcs.xml.dist; then
        "$bin" --warning-severity=0 -- "$@" >&2 || rc=$?
      else
        "$bin" --standard=PSR12 --warning-severity=0 --extensions=php -- "$@" >&2 || rc=$?
      fi
      [ "$rc" -le 2 ] || exit "$rc"
      for f in "$@"; do diff -u --label "a/$f" --label "b/$f" "${PHORWARD_TREE:-/project}/$f" "$f" || true; done
      exit 0
    fi
    if has phpcs.xml phpcs.xml.dist .phpcs.xml .phpcs.xml.dist; then
      exec "$bin" --warning-severity=0 "$@"
    fi
    if [ "$#" -gt 0 ]; then
      exec "$bin" --standard=PSR12 --warning-severity=0 --extensions=php -- "$@"
    fi
    dirs="$src"; [ -d tests ] && dirs="$dirs tests"
    [ -n "$dirs" ] || { echo "phorward-check: nothing to check (no src, lib, app or tests directory)" >&2; exit 2; }
    # shellcheck disable=SC2086  # a fixed list of directory names
    exec "$bin" --standard=PSR12 --warning-severity=0 --extensions=php $dirs ;;
  phpstan)
    if has phpstan.neon phpstan.neon.dist; then
      exec "$bin" analyse --no-progress --no-ansi --memory-limit=1G
    fi
    [ -n "$src" ] || { echo "phorward-check: nothing to analyse (no src, lib or app directory)" >&2; exit 2; }
    # shellcheck disable=SC2086
    exec "$bin" analyse --no-progress --no-ansi --memory-limit=1G --level=5 $src ;;
  phpunit)
    if [ "$#" -gt 0 ]; then exec "$bin" --no-progress "$@"; fi
    if has phpunit.xml phpunit.xml.dist; then exec "$bin" --no-progress; fi
    [ -d tests ] || { echo "phorward-check: no phpunit.xml and no tests directory" >&2; exit 2; }
    exec "$bin" --no-progress tests ;;
  *) echo "phorward-check: unknown tool $tool" >&2; exit 2 ;;
esac
