{
  "profile": "php-library",
  "description": "Sandbox for a plain PHP library or application: the project's own composer.lock is installed at build time, so phpunit, phpcs and phpstan run offline.",
  "provides": [
    "lint",
    "phpcbf",
    "phpcs",
    "phpstan",
    "phpunit"
  ],
  "build": {
    "name_from": "composer-package",
    "dev_packages": false,
    "needs_lock": true,
    "stale_hash_file": "composer.lock"
  },
  "base": {
    "php_image": "docker.io/library/php:{php}-cli-trixie",
    "composer_image": "docker.io/library/composer:2",
    "pins": {
      "php": {
        "8.3": "docker.io/library/php@sha256:628102249d93494233b54490b785f12db9cd60f4dc89416dfca15973f2125f10",
        "8.4": "docker.io/library/php@sha256:d63e8b80cd4c6cfd01cfa7c910522e299cdc7ca1a2b6d6563db48df3c17e6c55",
        "8.5": "docker.io/library/php@sha256:50956f094e90a716d43bea28087d447555ad80510e386ab8c9c10d8c70d781a9"
      },
      "composer": "docker.io/library/composer@sha256:8de2184c6de224f4689e8f80ed5f5edaf0030b6b8b7839a22a2bcb6722ac87d0"
    }
  },
  "versions": {
    "php": [
      "8.3",
      "8.4",
      "8.5"
    ],
    "policy": "Locked, moved on purpose. The base images are pinned by digest (build-image --pin-base) and the tools are installed from the lock files in locks/ (build-image --refresh-locks), so rebuilding the same inputs gives the same versions. The project's dependencies come from its own composer.lock."
  },
  "locks": [
    "lint-tools/composer.lock"
  ],
  "test_layout": "flat",
  "defaults": {
    "php": "8.3",
    "cpus": 2,
    "pids": 512,
    "memory": {
      "none": "2g"
    },
    "db": "none"
  },
  "tmpfs": [
    "/tmp:exec,size=1g"
  ],
  "env": {
    "HOME": "/tmp",
    "COMPOSER_HOME": "/tmp/.composer"
  },
  "databases": {
    "none": {}
  },
  "checks": {
    "lint": {
      "workdir": "{module_path}",
      "argv": [
        "sh",
        "-c",
        "out=$(find . -name '*.php' -not -path './vendor/*' -not -path './node_modules/*' -print0 | xargs -0 -n1 php -l 2>&1); rc=$?; printf '%s\\n' \"$out\" | grep -v '^No syntax errors detected'; exit $rc"
      ],
      "argv_paths": [
        "sh",
        "-c",
        "rc=0; for f in \"$@\"; do out=$(php -l \"$f\" 2>&1) || { printf '%s\\n' \"$out\"; rc=1; }; done; exit $rc",
        "sh",
        "{paths}"
      ]
    },
    "phpcbf": {
      "workdir": "/tmp",
      "default": false,
      "needs_paths": true,
      "patch": true,
      "argv": [
        "sh",
        "-c",
        "echo 'phpcbf needs --paths' >&2; exit 2"
      ],
      "argv_paths": [
        "with-project",
        "phorward-check",
        "phpcbf",
        "{paths}"
      ]
    },
    "phpcs": {
      "workdir": "/tmp",
      "argv": [
        "with-project",
        "phorward-check",
        "phpcs"
      ],
      "argv_paths": [
        "with-project",
        "phorward-check",
        "phpcs",
        "{paths}"
      ]
    },
    "phpstan": {
      "workdir": "/tmp",
      "argv": [
        "with-project",
        "phorward-check",
        "phpstan"
      ]
    },
    "phpunit": {
      "workdir": "/tmp",
      "tests_prefix": "",
      "argv": [
        "with-project",
        "phorward-check",
        "phpunit"
      ],
      "argv_tests": [
        "with-project",
        "phorward-check",
        "phpunit",
        "{tests}"
      ]
    }
  },
  "smoke": {
    "pick_tests": [
      "*/tests/*Test.php"
    ],
    "good_checks": [
      "lint",
      "phpcs",
      "phpunit"
    ],
    "bad": {
      "lint": {
        "file": "src/SmokeSyntax.php",
        "template": "smoke/SmokeSyntax.php"
      },
      "phpcs": {
        "file": "src/SmokeStyle.php",
        "template": "smoke/SmokeStyle.php"
      },
      "phpunit": {
        "file": "tests/SmokeFailingTest.php",
        "template": "smoke/SmokeFailingTest.php",
        "tests": [
          "tests/SmokeFailingTest.php"
        ]
      }
    },
    "scratch": {
      "phpstan": {
        "good": {
          "composer.json": "smoke/composer.json",
          "src/SmokeOk.php": "smoke/SmokeOk.php"
        },
        "bad": {
          "composer.json": "smoke/composer.json",
          "src/SmokeBad.php": "smoke/SmokeBad.php"
        }
      }
    },
    "readonly_paths": [
      "/opt/vendor"
    ]
  },
  "verify": {
    "source_extensions": [
      "php"
    ],
    "scan_extensions": [
      "php"
    ],
    "security": {
      "fail": [
        {
          "pattern": "\\beval\\s*\\(",
          "message": "eval()"
        },
        {
          "pattern": "->query\\(\\s*[\\\"'][^\\\"']*(\\$\\w+|\\{\\$)",
          "message": "SQL built by string interpolation: use placeholders"
        }
      ],
      "warn": [
        {
          "pattern": "\\bunserialize\\s*\\(",
          "message": "unserialize(): pass allowed_classes => false, or use JSON"
        },
        {
          "pattern": "\\b(shell_exec|passthru|system|proc_open|popen)\\s*\\(",
          "message": "shell execution: check every argument is escaped"
        },
        {
          "pattern": "\\$_(GET|POST|REQUEST|COOKIE)\\b",
          "message": "superglobal: read it once, at the edge"
        },
        {
          "pattern": "\\bmd5\\s*\\(|\\bsha1\\s*\\(",
          "message": "weak hash: fine only for cache keys, never for secrets"
        }
      ]
    }
  },
  "harness": {
    "kind": "a PHP library"
  }
}
