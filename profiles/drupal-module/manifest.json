{
  "profile": "drupal-module",
  "description": "Sandbox for a Drupal 11 module: Drupal core and core-dev baked in, so Kernel and Unit tests run offline.",
  "provides": [
    "lint",
    "phpcs",
    "phpstan",
    "phpunit"
  ],
  "build": {
    "name_from": "info.yml",
    "dev_packages": true,
    "needs_lock": false,
    "stale_hash_file": "composer.json"
  },
  "base": {
    "php_image": "docker.io/library/php:{php}-cli-trixie",
    "composer_image": "docker.io/library/composer:2",
    "pins": {
      "php": {
        "8.3": "docker.io/library/php@sha256:628102249d93494233b54490b785f12db9cd60f4dc89416dfca15973f2125f10",
        "8.4": "docker.io/library/php@sha256:d63e8b80cd4c6cfd01cfa7c910522e299cdc7ca1a2b6d6563db48df3c17e6c55",
        "8.5": "docker.io/library/php@sha256:50956f094e90a716d43bea28087d447555ad80510e386ab8c9c10d8c70d781a9"
      },
      "composer": "docker.io/library/composer@sha256:8de2184c6de224f4689e8f80ed5f5edaf0030b6b8b7839a22a2bcb6722ac87d0"
    }
  },
  "versions": {
    "php": [
      "8.3",
      "8.4",
      "8.5"
    ],
    "policy": "Locked, moved on purpose. The base images are pinned by digest (build-image --pin-base) and the tools are installed from the lock files in locks/ (build-image --refresh-locks), so rebuilding the same inputs gives the same versions. Drupal follows ^11 within the lock: a refresh picks up the newest 11.x. The module's own dependencies are resolved at build time on top of the locked project."
  },
  "locks": [
    "lint-tools/composer.lock",
    "drupal-project/composer.lock"
  ],
  "test_layout": "drupal",
  "defaults": {
    "php": "8.3",
    "cpus": 2,
    "pids": 512,
    "memory": {
      "mariadb": "6g",
      "sqlite": "4g",
      "none": "4g"
    },
    "db": "mariadb"
  },
  "tmpfs": [
    "/tmp:exec,size=1g",
    "/opt/drupal-project/web/sites/simpletest:mode=1777,size=1g"
  ],
  "env": {
    "SIMPLETEST_BASE_URL": "http://localhost"
  },
  "databases": {
    "mariadb": {
      "wrap": [
        "with-mariadb"
      ]
    },
    "sqlite": {
      "env": {
        "SIMPLETEST_DB": "sqlite://localhost//tmp/test.sqlite"
      }
    },
    "none": {}
  },
  "checks": {
    "lint": {
      "workdir": "{module_path}",
      "argv": [
        "sh",
        "-c",
        "out=$(find . \\( -name '*.php' -o -name '*.module' -o -name '*.inc' -o -name '*.install' -o -name '*.theme' -o -name '*.profile' \\) -not -path './vendor/*' -not -path './node_modules/*' -print0 | xargs -0 -n1 php -l 2>&1); rc=$?; printf '%s\\n' \"$out\" | grep -v '^No syntax errors detected'; exit $rc"
      ]
    },
    "phpcs": {
      "workdir": "{module_path}",
      "argv": [
        "phpcs",
        "--warning-severity=0"
      ]
    },
    "phpstan": {
      "workdir": "{module_path}",
      "argv": [
        "sh",
        "-c",
        "if [ -f phpstan.neon ] || [ -f phpstan.neon.dist ]; then /opt/drupal-project/vendor/bin/phpstan analyse --no-progress --no-ansi --memory-limit=1G; else /opt/drupal-project/vendor/bin/phpstan analyse --no-progress --no-ansi --memory-limit=1G .; fi"
      ]
    },
    "phpunit": {
      "workdir": "/opt/drupal-project",
      "uses_db": true,
      "argv": [
        "sh",
        "-c",
        "find \"$1\" \\( -path '*/tests/src/Unit/*Test.php' -o -path '*/tests/src/Kernel/*Test.php' \\) -not -path '*/vendor/*' -print0 | sort -z | xargs -0 phpunit -c web/core --no-progress",
        "sh",
        "{module_path}"
      ],
      "argv_tests": [
        "phpunit",
        "-c",
        "web/core",
        "--no-progress",
        "{tests}"
      ]
    }
  },
  "smoke": {
    "pick_tests": [
      "*/tests/src/Unit/*Test.php",
      "*/tests/src/Kernel/*Test.php"
    ],
    "good_checks": [
      "lint",
      "phpcs",
      "phpunit"
    ],
    "bad": {
      "lint": {
        "file": "src/SmokeSyntax.php",
        "template": "smoke/SmokeSyntax.php"
      },
      "phpcs": {
        "file": "src/SmokeStyle.php",
        "template": "smoke/SmokeStyle.php"
      },
      "phpunit": {
        "file": "tests/src/Unit/SmokeFailingTest.php",
        "template": "smoke/SmokeFailingTest.php",
        "tests": [
          "tests/src/Unit/SmokeFailingTest.php"
        ]
      }
    },
    "scratch": {
      "phpstan": {
        "good": {
          "SmokeOk.php": "smoke/SmokeOk.php"
        },
        "bad": {
          "SmokeBad.php": "smoke/SmokeBad.php"
        }
      }
    },
    "readonly_paths": [
      "/opt/drupal-project/web/core"
    ]
  },
  "verify": {
    "source_extensions": [
      "php",
      "module",
      "install",
      "inc",
      "theme",
      "profile"
    ],
    "scan_extensions": [
      "php",
      "module",
      "install",
      "inc",
      "theme",
      "profile",
      "yml",
      "twig"
    ],
    "security": {
      "fail": [
        {
          "pattern": "\\beval\\s*\\(",
          "message": "eval()"
        },
        {
          "pattern": "->query\\(\\s*[\\\"'][^\\\"']*(\\$\\w+|\\{\\$)",
          "message": "SQL built by string interpolation: use placeholders"
        },
        {
          "pattern": "\\bunserialize\\s*\\(",
          "message": "unserialize(): use Json or pass allowed_classes => FALSE"
        },
        {
          "pattern": "\\b(shell_exec|passthru|system|proc_open|popen)\\s*\\(",
          "message": "shell execution"
        },
        {
          "pattern": "_access:\\s*['\\\"]?TRUE['\\\"]?",
          "message": "route open to everyone (_access: TRUE)"
        },
        {
          "pattern": "\\$_(GET|POST|REQUEST|COOKIE)\\b",
          "message": "superglobal: use the request object"
        },
        {
          "pattern": "\\bmd5\\s*\\(|\\bsha1\\s*\\(",
          "message": "weak hash: fine only for cache keys, never for secrets"
        }
      ],
      "warn": [
        {
          "pattern": "accessCheck\\(\\s*FALSE\\s*\\)",
          "message": "accessCheck(FALSE) skips entity access: needs a stated reason"
        },
        {
          "pattern": "'#markup'\\s*=>\\s*\\$",
          "message": "#markup from a variable: escape it or use #plain_text"
        },
        {
          "pattern": "\\bXss::filter(Admin)?\\b|\\bMarkup::create\\(",
          "message": "marks output as safe: check the input is trusted"
        },
        {
          "pattern": "\\\\Drupal::(database|entityTypeManager|currentUser)\\(\\)",
          "message": "static service call in a class: inject the service"
        },
        {
          "pattern": "\\bFilterAdmin\\b|\\|raw\\b",
          "message": "raw output in a template"
        }
      ]
    }
  }
}
