{
    "name": "deburca/phorward",
    "description": "Offload PHP lint, phpcs, phpstan and phpunit runs to an SSH-reachable server, each in a throwaway sandboxed container.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["phpunit", "phpcs", "phpstan", "ssh", "docker", "sandbox", "ci"],
    "authors": [
        {
            "name": "Paddy de Búrca",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "Phorward\\": "src/"
        }
    },
    "bin": ["bin/phorward"],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
