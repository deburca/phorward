{
    "name": "deburca/phorward",
    "description": "Offload PHP lint, phpcs, phpstan and phpunit runs to an SSH-reachable server, each in a throwaway sandboxed container.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/deburca/phorward",
    "keywords": ["phpunit", "phpcs", "phpstan", "ssh", "docker", "sandbox", "ci"],
    "authors": [
        {
            "name": "Paddy de Búrca",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "symfony/process": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Phorward\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/deburca/phorward/issues",
        "source": "https://github.com/deburca/phorward",
        "docs": "https://github.com/deburca/phorward/tree/main/docs"
    },
    "bin": ["bin/phorward"],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Phorward\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
