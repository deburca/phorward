#!/usr/bin/env bash
# Smoke test for a phorward validation image: runs the checks through phorward-run, as a client would, on a
# good copy of a project and on deliberately broken copies, then checks the sandbox itself (no network,
# read-only root, non-root user). Exit 0 = every check behaved as expected.
#   smoke-test --module PATH [--profile drupal-module] [--php 8.3] [--tests "path/a path/b"]
# The image tested is the one phorward-run would pick: phorward:<name>-php<version>, built by build-image
# from the same project. Which checks run, which broken files are planted, and which tests are picked all come
# from the profile's manifest (smoke section). Without --tests, the first test matching each of the manifest's
# pick_tests patterns is used. The image's labels give the mount path.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
PROFILE="drupal-module"
PHP=""
MODULE="${PHORWARD_MODULE_DIR:-}"
TESTS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --profile) PROFILE="$2"; shift 2 ;;
    --php) PHP="$2"; shift 2 ;;
    --module) MODULE="$2"; shift 2 ;;
    --tests) TESTS="$2"; shift 2 ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done
if [ -z "$MODULE" ] || [ ! -d "$MODULE" ]; then echo "need --module PATH (a project checkout)" >&2; exit 2; fi
ENGINE="${PHORWARD_ENGINE:-$(command -v podman || command -v docker || true)}"
[ -n "$ENGINE" ] || { echo "neither podman nor docker is installed" >&2; exit 2; }
manifest() { "$HERE/manifest-get" "$PROFILE" "$@"; }
[ -n "$(manifest profile)" ] || { echo "unknown profile: $PROFILE" >&2; exit 2; }
[ -n "$PHP" ] || PHP="$(manifest defaults.php)"
NAME="$("$HERE/build-image" --profile "$PROFILE" --module "$MODULE" --print-name)" || exit 2
IMAGE="phorward:${NAME}-php${PHP}"

# Without the image every must-fail check below would pass for the wrong reason, so stop here.
"$ENGINE" image inspect "$IMAGE" >/dev/null 2>&1 || { echo "image not found: $IMAGE" >&2; exit 2; }
label() { "$ENGINE" image inspect -f "{{index .Config.Labels \"$1\"}}" "$IMAGE"; }
M="$(label phorward.module-path)"
if [ "$(label phorward.profile)" != "$PROFILE" ] || [ -z "$M" ]; then
  echo "image $IMAGE is not a $PROFILE image (labels phorward.profile / phorward.module-path)" >&2; exit 2
fi

WORK="$(mktemp -d)"
trap 'rm -rf "${WORK:?}"' EXIT
FAILS=0
cat > "$WORK/policy.json" <<EOF
{"allowed_profiles": ["$PROFILE"], "max_timeout": 900, "default_timeout": 900, "slots": 1, "slot_wait": 5,
 "max_memory": "6g", "results_dir": "$WORK/results", "lock_dir": "$WORK/locks"}
EOF

# A database the profile offers for quick runs: SQLite if it has it, else its default.
DB_ARGS=()
[ -z "$(manifest databases.sqlite)" ] || DB_ARGS=(--db sqlite)

if [ -z "$TESTS" ]; then
  while IFS= read -r pattern; do
    [ -n "$pattern" ] || continue
    picked="$(cd "$MODULE" && find . -path "$pattern" -not -path '*/vendor/*' | sort | head -1 | sed 's|^\./||')"
    [ -z "$picked" ] || TESTS="${TESTS:+$TESTS }$picked"
  done < <(manifest smoke.pick_tests --lines)
fi
TESTS_CSV="${TESTS// /,}"

stage() {   # stage <dir>: copy the project the way a run will, minus what a run never needs
  mkdir -p "$1"
  rsync -a --exclude=.git --exclude=vendor --exclude=node_modules "$MODULE/" "$1/"
}

plant() {   # plant <dir> <path> <template>: a file from the profile's smoke templates, __NAME__ filled in
  mkdir -p "$(dirname "$1/$2")"
  sed "s/__NAME__/$NAME/g" "$HERE/../profiles/$PROFILE/$3" > "$1/$2"
}

# run_check <pass|fail> <label> <tree> <check> [extra phorward-run options...]
# Runs one check through phorward-run. `pass` needs exit 0 and the check passed; `fail` needs exit 1 and the
# check failed (not an infrastructure error, which is also non-zero but proves nothing about the check).
run_check() {
  local want="$1" label="$2" tree="$3" check="$4"; shift 4
  tar -C "$tree" -cf - . | PHORWARD_POLICY="$WORK/policy.json" PHORWARD_ENGINE="$ENGINE" \
    "$HERE/phorward-run" run --protocol 1 --profile "$PROFILE" --php "$PHP" --module "$NAME" --checks "$check" "$@" \
    > "$WORK/result.json" 2> "$WORK/run.err"
  local rc=${PIPESTATUS[1]} status
  status="$(python3 -I -c '
import json, sys
try:
    r = json.load(open(sys.argv[1]))
    c = [x for x in r["checks"] if x["name"] == sys.argv[2]]
    print(c[0]["status"] if c else r.get("error", {}).get("code", "none"))
except Exception:
    print("no-json")' "$WORK/result.json" "$check")"
  local wantrc=0 wantstatus=passed
  if [ "$want" = fail ]; then wantrc=1; wantstatus=failed; fi
  if [ "$rc" -eq "$wantrc" ] && [ "$status" = "$wantstatus" ]; then
    echo "ok    $label (exit $rc, $check $status)"
  else
    echo "FAIL  $label: expected exit $wantrc and $wantstatus, got exit $rc and $status"
    python3 -I -c '
import json, sys
try:
    for c in json.load(open(sys.argv[1]))["checks"]:
        if c["name"] == sys.argv[2] and c.get("output"):
            print(c["output"][-1500:])
except Exception:
    pass' "$WORK/result.json" "$check" | tail -8 | sed 's/^/        /'
    tail -3 "$WORK/run.err" | sed 's/^/        /'
    FAILS=$((FAILS + 1))
  fi
}

TMPFS=()
while IFS= read -r spec; do [ -z "$spec" ] || TMPFS+=(--tmpfs "$spec"); done < <(manifest tmpfs --lines)

# shellcheck disable=SC2317,SC2329  # invoked indirectly through expect (the code is the older and newer name of this note)
sandbox() {   # sandbox <dir> <cmd...>: the limits every validation run gets, for checks of the sandbox itself
  local dir="$1"; shift
  "$ENGINE" run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges \
    --pids-limit 512 --memory "${SANDBOX_MEMORY:-4g}" --cpus 2 ${TMPFS[@]+"${TMPFS[@]}"} \
    -v "$dir:$M:ro" "$IMAGE" "$@"
}

expect() {   # expect <pass|fail> <label> <cmd...>
  local want="$1" label="$2"; shift 2
  "$@" >"$WORK/out.log" 2>&1
  local rc=$?
  if { [ "$want" = pass ] && [ $rc -eq 0 ]; } || { [ "$want" = fail ] && [ $rc -ne 0 ]; }; then
    echo "ok    $label (rc=$rc)"
  else
    echo "FAIL  $label: expected $want, rc=$rc"; tail -8 "$WORK/out.log" | sed 's/^/        /'; FAILS=$((FAILS+1))
  fi
}

echo "image: $IMAGE  (profile $PROFILE, project $NAME at $M)"
"$ENGINE" run --rm --network none "$IMAGE" cat /opt/TOOL-VERSIONS | sed 's/^/  /'
echo "tests picked: ${TESTS:-none}"

stage "$WORK/good"
echo "-- good tree"
while IFS= read -r check; do
  [ -n "$check" ] || continue
  if [ "$check" = phpunit ]; then
    if [ -z "$TESTS" ]; then echo "FAIL  phpunit: no tests found to run"; FAILS=$((FAILS + 1)); continue; fi
    run_check pass "phpunit passes ($TESTS)" "$WORK/good" phpunit --tests "$TESTS_CSV" ${DB_ARGS[@]+"${DB_ARGS[@]}"}
  else
    run_check pass "$check passes on the project" "$WORK/good" "$check"
  fi
done < <(manifest smoke.good_checks --lines)

echo "-- broken trees"
while IFS=$'\t' read -r check file template tests; do
  [ -n "$check" ] || continue
  stage "$WORK/bad-$check"
  plant "$WORK/bad-$check" "$file" "$template"
  if [ "$check" = phpunit ]; then
    run_check fail "phpunit catches a failing test" "$WORK/bad-$check" phpunit --tests "$tests" ${DB_ARGS[@]+"${DB_ARGS[@]}"}
  else
    run_check fail "$check catches a broken file" "$WORK/bad-$check" "$check"
  fi
done < <(manifest smoke.bad | python3 -I -c '
import json, sys
for check, spec in json.loads(sys.stdin.read() or "{}").items():
    print("\t".join([check, spec["file"], spec["template"], ",".join(spec.get("tests", []))]))')

# --paths and phpcbf: only for profiles that have a phpcs smoke case (they all do today) and the phpcbf check.
if [ -n "$(manifest smoke.bad.phpcs)" ] && [ -n "$(manifest checks.phpcbf)" ]; then
  echo "-- paths and patch"
  bad_file="$(manifest smoke.bad.phpcs | python3 -I -c 'import json, sys; print(json.loads(sys.stdin.read())["file"])')"
  clean_file="$(cd "$WORK/good" && find . -name '*.php' -not -path './vendor/*' -not -path './tests/*' | sed 's#^\./##' | grep -v "^$bad_file\$" | head -1)"
  run_check fail "phpcs --paths catches the broken file it is asked about" "$WORK/bad-phpcs" phpcs --paths "$bad_file"
  if [ -n "$clean_file" ]; then
    run_check pass "phpcs --paths leaves alone a broken file it is not asked about" "$WORK/bad-phpcs" phpcs --paths "$clean_file"
  fi
  tar -C "$WORK/bad-phpcs" -cf - . | PHORWARD_POLICY="$WORK/policy.json" PHORWARD_ENGINE="$ENGINE" \
    "$HERE/phorward-run" run --protocol 1 --profile "$PROFILE" --php "$PHP" --module "$NAME" --checks phpcbf --paths "$bad_file" \
    > "$WORK/result.json" 2> "$WORK/run.err"
  rc=${PIPESTATUS[1]}
  if [ "$rc" -eq 0 ] && python3 -I -c '
import json, sys
r = json.load(open(sys.argv[1]))
c = [x for x in r["checks"] if x["name"] == "phpcbf"][0]
assert c["status"] == "passed" and c["scope"] == "paths", c
assert c["patch"].startswith("--- a/" + sys.argv[2] + "\n+++ b/" + sys.argv[2] + "\n"), c["patch"][:200]
assert "@@" in c["patch"] and c["patch_bytes"] == len(c["patch"].encode())' "$WORK/result.json" "$bad_file"; then
    echo "ok    phpcbf returns a patch for the broken file (exit 0)"
  else
    echo "FAIL  phpcbf did not return a usable patch (exit $rc)"; tail -3 "$WORK/run.err" | sed 's/^/        /'; FAILS=$((FAILS + 1))
  fi
  # The patch must apply to the original and change it (phpcbf cannot fix every finding, so phpcs may still fail).
  stage "$WORK/fixed"
  plant "$WORK/fixed" "$bad_file" "$(manifest smoke.bad.phpcs | python3 -I -c 'import json, sys; print(json.loads(sys.stdin.read())["template"])')"
  cp "$WORK/fixed/$bad_file" "$WORK/original.php"
  python3 -I -c '
import json, sys
c = [x for x in json.load(open(sys.argv[1]))["checks"] if x["name"] == "phpcbf"][0]
open(sys.argv[2], "w").write(c["patch"])' "$WORK/result.json" "$WORK/fix.patch" 2>/dev/null
  if [ -s "$WORK/fix.patch" ] && (cd "$WORK/fixed" && patch -s -p1 < "$WORK/fix.patch" >/dev/null 2>&1) \
      && ! cmp -s "$WORK/original.php" "$WORK/fixed/$bad_file"; then
    echo "ok    the patch applies and changes the file"
  else
    echo "FAIL  the patch did not apply or changed nothing"; FAILS=$((FAILS + 1))
  fi
fi

echo "-- scratch trees (checks that must hold whatever state the project itself is in)"
while IFS=$'\t' read -r check kind path template; do
  [ -n "$check" ] || continue
  mkdir -p "$WORK/scratch-$check-$kind"
  plant "$WORK/scratch-$check-$kind" "$path" "$template"
done < <(manifest smoke.scratch | python3 -I -c '
import json, sys
for check, kinds in json.loads(sys.stdin.read() or "{}").items():
    for kind, files in kinds.items():
        for path, template in files.items():
            print("\t".join([check, kind, path, template]))')
for dir in "$WORK"/scratch-*; do
  [ -d "$dir" ] || continue
  rest="${dir##*/scratch-}"; check="${rest%-*}"; kind="${rest##*-}"
  if [ "$kind" = good ]; then
    run_check pass "$check passes clean code" "$dir" "$check"
  else
    run_check fail "$check catches bad code" "$dir" "$check"
  fi
done

if [ -n "$(manifest databases.mariadb)" ]; then
  echo "-- with-mariadb"
  # MariaDB and its tmpfs datadir share the container's memory limit, hence 6g.
  export SANDBOX_MEMORY=6g
  # shellcheck disable=SC2016  # the expressions must expand inside the container
  expect pass "with-mariadb sets SIMPLETEST_DB and serves queries" sandbox "$WORK/good" with-mariadb sh -c \
    'case "$SIMPLETEST_DB" in mysql://*) ;; *) exit 1;; esac; [ "$(mariadb --no-defaults -h127.0.0.1 -udrupal -pdrupal -N -e "SELECT 1" drupal)" = 1 ]'
  expect pass "with-mariadb shuts the server down afterwards" sandbox "$WORK/good" sh -c \
    'with-mariadb true; ! mariadb-admin --no-defaults --socket=/tmp/mariadb/sock ping >/dev/null 2>&1'
  expect pass "with-mariadb returns the command's exit status" sandbox "$WORK/good" sh -c \
    'with-mariadb sh -c "exit 7"; [ $? -eq 7 ]'
  unset SANDBOX_MEMORY
fi

echo "-- sandbox"
expect fail "no network"          sandbox "$WORK/good" php -r 'exit(@file_get_contents("http://1.1.1.1", false, stream_context_create(["http"=>["timeout"=>3]])) === false ? 1 : 0);'
expect fail "root fs read-only"   sandbox "$WORK/good" sh -c 'touch /etc/smoke'
expect fail "module mount read-only" sandbox "$WORK/good" sh -c "touch $M/smoke"
while IFS= read -r path; do
  [ -n "$path" ] || continue
  expect fail "$path read-only" sandbox "$WORK/good" sh -c "touch $path/smoke"
done < <(manifest smoke.readonly_paths --lines)
# shellcheck disable=SC2016  # the expression must expand inside the container
expect pass "runs as non-root"    sandbox "$WORK/good" sh -c '[ "$(id -u)" = 10001 ]'

echo; if [ $FAILS -eq 0 ]; then echo "smoke test: all checks passed"; else echo "smoke test: $FAILS check(s) FAILED"; fi
exit $((FAILS > 0))
