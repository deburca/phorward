#!/usr/bin/env php
<?php

/**
 * phorward command line entry point.
 *
 * Commands: help, version, config, doctor, server:install and run. The server-side tools in server/ can also be
 * used directly.
 */

declare(strict_types=1);

// Installed as a dependency the autoloader is three levels up; in a checkout it is in vendor/.
foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
  if (is_file($autoload)) {
    require $autoload;
    break;
  }
}
if (!class_exists(\Phorward\Cli\Application::class)) {
  fwrite(STDERR, "phorward: cannot find the Composer autoloader. Run \"composer install\".\n");
  exit(2);
}

// A project tree is built and sent as one string; PHP's default 128 MB would end in a bare fatal error.
if (($limit = trim((string) ini_get('memory_limit'))) !== '-1' && (int) $limit < 512 && !preg_match('/[gG]$/', $limit)) {
  ini_set('memory_limit', '512M');
}

$app = new \Phorward\Cli\Application(\Phorward\Config\Schema::standard(), \Phorward\Cli\Output::standard());
exit($app->run(array_slice($argv, 1), getenv(), getcwd() ?: '.'));
